{
  "name": "local-first-ed-app",
  "author": "MS Gunaratne",
  "description": "A local-first app built with React, TanStack Router, and Drizzle ORM, showcasing offline capabilities and seamless data synchronization",
  "repository": {
    "type": "git",
    "url": "https://github.com/MSGunaratne/local-first-ed-app.git"
  },
  "homepage": "https://local-first-ed-app.fyp-dashboard.workers.dev",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsx scripts/verify-sw.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ed-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ed-app-db --remote",
    "db:query:local": "wrangler d1 execute ed-app-db --local --command",
    "db:query:remote": "wrangler d1 execute ed-app-db --remote --command"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/drizzle-adapter": "^1.5.6",
    "@cloudflare/vite-plugin": "^1.30.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-query-persist-client": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "latest",
    "@tiptap/core": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-phone-number-input": "^3.4.16",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "wa-sqlite": "github:rhashimoto/wa-sqlite",
    "workbox-background-sync": "^7.4.0",
    "workbox-recipes": "^7.4.0",
    "workbox-window": "^7.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@inlang/paraglide-js": "^2.15.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "workbox-build": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "wrangler": "^4.77.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}