{
  "name": "local-first-ed-app",
  "author": "MS Gunaratne",
  "description": "A local-first app built with React, TanStack Router, and Drizzle ORM, showcasing offline capabilities and seamless data synchronization",
  "repository": {
    "type": "git",
    "url": "https://github.com/MSGunaratne/local-first-ed-app.git"
  },
  "homepage": "https://local-first-ed-app.fyp-dashboard.workers.dev",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsx scripts/verify-sw.ts",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/**/*.benchmark.ts",
    "test:unit": "vitest run --exclude tests/**/*.benchmark.ts",
    "test:benchmarks": "vitest run tests/benchmarks/stress.benchmark.ts",
    "test:e2e": "pnpm run build && playwright test",
    "test:all": "pnpm run typecheck && pnpm run test:unit && pnpm run test:benchmarks && pnpm run build && pnpm run test:e2e",
    "test:report": "node scripts/generate-testing-report.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ed_app_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ed_app_db --remote",
    "db:query:local": "wrangler d1 execute ed_app_db --local --command",
    "db:query:remote": "wrangler d1 execute ed_app_db --remote --command"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-query-persist-client": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "latest",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "3.27.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "3.27.3",
    "@tiptap/extension-unique-id": "3.27.3",
    "@tiptap/extensions": "3.27.3",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^15.0.0",
    "react-phone-number-input": "^3.4.18",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "wa-sqlite": "github:rhashimoto/wa-sqlite",
    "workbox-background-sync": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "jsdom": "^28.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.147.0"
  }
}
